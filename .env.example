# Copy to .env for local development (never commit .env).
# Every variable below is validated at startup (src/config/env.validation.ts):
# the app refuses to start with an invalid value and names the variable, never its value.

# development | production | test
NODE_ENV=development

# Port the API listens on. The Next.js frontend uses 3000, so the API uses 4000.
PORT=4000

# Global route prefix. Routes are served under /<API_PREFIX>, e.g. /api/v1/health.
API_PREFIX=api/v1

# Comma-separated list of browser origins allowed by CORS. Exact origins only: "*" is rejected.
# Production must set this explicitly to the real frontend origin(s).
CORS_ORIGINS=http://localhost:3000

# Serve Swagger UI at /api/docs. Defaults to true outside production and false in production.
# SWAGGER_ENABLED=true

# --- Supabase Auth (Project Settings -> API) --------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# SERVER ONLY. Used exclusively for the Auth Admin API (create/delete users, set passwords).
# It is never used for database queries and must never reach a browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_URL=
# Only for legacy projects that still sign access tokens with a shared HS256 secret. Leave unset with JWKS.
# SUPABASE_JWT_SECRET=

# --- PostgreSQL (Supabase TRANSACTION pooler, port 6543) ---------------------------------------
# MUST connect as the restricted `storeforge_app` role, never `postgres` (it bypasses row level
# security; the app refuses to start with it). Pooler usernames are "<role>.<project-ref>":
#   postgresql://storeforge_app.<project-ref>:<APP_ROLE_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Scripts only (never read by the running API) --------------------------------------------
# Privileged owner connection (postgres user; direct or SESSION pooler, port 5432) used by
# `npm run db:migrate`, `db:state`, `admin:create` and `db:seed:demo`. Not needed at runtime.
# DIRECT_URL=
# PLATFORM_ADMIN_PASSWORD=   # read by admin:create, 12+ characters; set it only for the command
# SEED_DEMO_DATA=true        # required by db:seed:demo

# --- Rate limiting (global default; sensitive routes set stricter limits) -----------------------
# THROTTLE_TTL_SECONDS=60
# THROTTLE_LIMIT=120
