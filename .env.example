# Copy to .env for local development (never commit .env).
# Every variable the API reads is validated at startup (src/config/env.validation.ts): the app refuses to
# start with a missing or invalid one and names the variable, never its value.
#
#   REQUIRED     - the API will not start without it
#   REQUIRED*    - needed by the npm scripts (migrate, admin:create, seed), not by the running API
#   optional     - has a default; uncomment only to change it

# =====================================================================================================
# Application
# =====================================================================================================

# optional - development | production | test
NODE_ENV=development

# optional - port the API listens on (the Next.js frontend uses 3000)
PORT=4000

# optional - global route prefix: routes are served under /<API_PREFIX>, e.g. /api/v1/health
API_PREFIX=api/v1

# optional - comma-separated browser origins allowed by CORS. Exact origins only: "*" is rejected.
# Production must set this to the real frontend origin(s).
CORS_ORIGINS=http://localhost:3000

# optional - serve Swagger UI at /api/docs. On outside production, off in production.
# SWAGGER_ENABLED=true

# =====================================================================================================
# Supabase Auth (Dashboard -> Project Settings -> API)
# =====================================================================================================

# REQUIRED - https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# REQUIRED - the public "anon" key (>= 20 characters)
SUPABASE_ANON_KEY=your-anon-public-key

# REQUIRED - the "service_role" key (>= 20 characters). SERVER ONLY: used exclusively for the Auth Admin API
# (create/delete users, set passwords). Never used for database queries; must never reach a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# optional - defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_URL=

# optional - only for legacy projects that still sign access tokens with a shared HS256 secret. Leave unset with JWKS.
# SUPABASE_JWT_SECRET=

# =====================================================================================================
# PostgreSQL (Supabase)
# =====================================================================================================

# REQUIRED - the running API. TRANSACTION pooler (port 6543) as the restricted `storeforge_app` role, never
# `postgres` (it bypasses row level security; the app refuses to start with it). Pooler usernames are
# "<role>.<project-ref>":
#   postgresql://storeforge_app.<project-ref>:<APP_ROLE_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://storeforge_app.your-project-ref:your-app-role-password@aws-0-region.pooler.supabase.com:6543/postgres

# REQUIRED* - migrations and scripts only (npm run db:migrate, db:state, db:verify-schema, admin:create,
# db:seed:demo). The privileged `postgres` owner over a direct connection (db.<ref>.supabase.co:5432) or the
# SESSION pooler (port 5432) if your network has no IPv6. Never used by the running API.
#   postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# =====================================================================================================
# Cookie session (login / logout / refresh through this API)
# =====================================================================================================

# optional but RECOMMENDED when the Next.js app signs users in through this API: a shared secret (32+ characters) that
# the Next.js server sends as `X-Internal-Auth`. It proves the call comes from the trusted frontend server, which
# lets the API (1) take the real visitor address from X-Forwarded-For for login rate limiting and (2) accept
# cookie-session requests that carry no browser Origin. Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the SAME value as AUTH_BFF_SECRET in the Next.js app. Never expose it to a browser.
# AUTH_BFF_SECRET=

# optional - keys the hashes behind login rate limiting (16+ characters). Defaults to SUPABASE_SERVICE_ROLE_KEY.
# RATE_LIMIT_SECRET=

# =====================================================================================================
# Rate limiting
# =====================================================================================================

# optional - global per-client limit; sensitive routes set stricter limits of their own
# THROTTLE_TTL_SECONDS=60
# THROTTLE_LIMIT=120

# =====================================================================================================
# One-off script inputs (set in the shell for a single command rather than saving them here)
# =====================================================================================================

# npm run admin:create -- --email you@x.com : password of the new Platform Admin (12+ characters)
#   PowerShell:  $env:PLATFORM_ADMIN_PASSWORD = "..." ; npm run admin:create -- --email you@x.com
# PLATFORM_ADMIN_PASSWORD=

# npm run db:seed:demo : explicit confirmation. Creates dummy logins with a PUBLIC password - dev projects only.
# SEED_DEMO_DATA=true
# SEED_DEMO_USER_EMAIL=      # optional: an existing confirmed user to own the demo store
