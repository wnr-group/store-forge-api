# Copy to .env.local (preferred for local overrides) or .env (never commit .env or .env.local).
# Environment files are loaded in order: .env.local first, then .env.
# Every variable below is validated at startup (src/config/env.validation.ts):
# the app refuses to start with an invalid value and names the variable, never its value.

# development | production | test
NODE_ENV=development

# Port the API listens on. The Next.js frontend uses 3000, so the API uses 4000.
PORT=4000

# Global route prefix. Routes are served under /<API_PREFIX>, e.g. /api/v1/health.
API_PREFIX=api/v1

# Comma-separated list of browser origins allowed by CORS. Exact origins only: "*" is rejected.
# Production must set this explicitly to the real frontend origin(s).
CORS_ORIGINS=http://localhost:3000

# Serve Swagger UI at /api/docs. Defaults to true outside production and false in production.
# SWAGGER_ENABLED=true

# Database connection (PostgreSQL / Supabase via PgBouncer or direct).
# MUST connect as the storeforge_app role (or storeforge_app.<ref> for pooler).
# postgres and postgres.<ref> superuser roles are rejected.
# Required unless NODE_ENV=test.
DATABASE_URL=postgresql://storeforge_app.xrkwyjnjemyxrbdbfmcn:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Connection pool settings
DB_POOL_MAX=5
DB_PREPARE=false
DB_CONNECT_TIMEOUT_SECONDS=10
